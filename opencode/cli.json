{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "one-dark"
  },
  "animations": false,
  "session": {
    "sidebar": "auto",
    "thinking": "show",
    "verbosity": "low"
  },
  "tabs": {
    "mode": "on",
    "scope": "cwd",
    "layout": "horizontal"
  },
  "keybinds": {
    "session.verbosity.cycle": "<leader>v"
  }
}
